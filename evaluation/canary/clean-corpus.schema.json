{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SafeShift known-clean canary false-positive corpus record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "exampleId", "text", "source", "category", "cleanAssertion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "exampleId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{3,160}$" },
    "text": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "cleanAssertion": { "const": "NO_CONFIGURED_CANARY" },
    "hardNegative": { "type": "boolean" },
    "metadata": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
    }
  }
}
