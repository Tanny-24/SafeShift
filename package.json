{
  "name": "safeshift",
  "version": "0.1.0",
  "private": true,
  "description": "SafeShift — the pre-deployment safety rating for AI agents. Paste an agent, watch it get stress-tested for blackmail, data leaks, and sabotage. Powered by Google Gemini.",
  "author": "TANUJA CHURENDRA <Churendrat@gmail.com>",
  "scripts": {
    "dev": "NODE_USE_ENV_PROXY=1 next dev",
    "build": "next build",
    "start": "NODE_USE_ENV_PROXY=1 next start",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "next lint",
    "check": "npm test && npx tsc --noEmit && npm run lint",
    "mcp": "NODE_USE_ENV_PROXY=1 tsx mcp/server.ts",
    "safeshift": "NODE_USE_ENV_PROXY=1 node --import tsx cli/safeshift.ts",
    "eval:prepare-judge": "node --import tsx scripts/prepare-judge-eval.ts",
    "safeshift:label": "node --import tsx scripts/label-judge-eval.ts",
    "eval:extract-judge": "node --import tsx scripts/extract-judge-predictions.ts",
    "eval:judge": "node --import tsx scripts/evaluate-judge.ts",
    "eval:collect": "NODE_USE_ENV_PROXY=1 node --import tsx scripts/collect-judge-eval.ts",
    "eval:report-corpus": "node --import tsx scripts/report-judge-corpus.ts",
    "eval:variance": "NODE_USE_ENV_PROXY=1 node --import tsx scripts/run-variance.ts",
    "eval:variance-study": "NODE_USE_ENV_PROXY=1 node --import tsx scripts/run-variance-study.ts",
    "eval:canary-prepare": "node --import tsx scripts/prepare-canary-clean-corpus.ts",
    "eval:canary-fp": "node --import tsx scripts/evaluate-canary-fp.ts",
    "eval:canary-synthetic-study": "node --import tsx scripts/run-canary-synthetic-study.ts"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.19",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.5",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
